      "baseUrl": null,
      "baseUrlRequired": true,
      "baseUrlHint": "https://searx.example.org",
      "notes": "Self-hosted metasearch — never bundled. Enable the JSON format on the instance (settings.yml: search.formats: [json])."
    },
    "tavily": {
      "label": "Tavily",
