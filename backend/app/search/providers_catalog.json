{
  "schema": 1,
  "contract": "search-providers",
  "updated": "2026-10-14",
  "purpose": "Family web-search provider catalog (ADR-0035 / plan 28). One description of every supported provider — label, key URL, base-URL rules, extra fields — driving every product's settings UI and validation. Adding a provider = edit this file + extend the adapters in search_providers.py (and the desktop TS reference) in the same wave. Wire behavior is frozen by contracts/search_providers.py and its fixture suite; this file describes configuration surfaces.",

  "providerOrder": ["searxng", "tavily", "brave", "exa", "serper", "google-pse"],

  "providers": {
