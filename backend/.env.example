# Study Assistant backend configuration (copy to .env and adjust as needed).
# All values are optional — the app ships with sensible defaults.
# API keys for AI providers are NOT set here; they are stored in the OS
# keyring via the app's Settings UI.

# Server
# SA_HOST=
# SA_PORT=
# SA_DEBUG=
# SA_LOG_LEVEL=
# Fail-safe default "production" (boot guards apply); dev scripts set
# "development". "test" is for the test suite only.
# SA_APP_ENV=

# Identity & security (identity-auth §4/§8/§16; ADR-0028)
# Entrypoint: server (docker/web) or desktop (python -m studyassistant).
# Unknown values fail closed to server.
# SA_IDENTITY_MODE=
# Init-only: seeds instance_settings.auth_mode on an EMPTY DB (open |
# authenticated); ignored afterwards with a loud warning. Unknown values
# fail closed to authenticated; open is never legal on a server.
# SA_AUTH_MODE=
# Init-only: seeds instance_settings.demo_mode (production boots refuse).
# SA_DEMO_MODE=
# Self-service registration gate.
# SA_REGISTRATION_ENABLED=
# Cookie/session policy (minutes/days/counts).
# SA_COOKIE_SECURE=
# SA_AUTH_ACCESS_TTL_MINUTES=
# SA_AUTH_REFRESH_TTL_DAYS=
# SA_AUTH_REFRESH_ABSOLUTE_DAYS=
# SA_AUTH_LOCKOUT_THRESHOLD=
# SA_AUTH_LOCKOUT_MINUTES=
# SA_AUTH_PASSWORD_MIN_LENGTH=
# Rightmost N X-Forwarded-For hops trusted for client identity (0 = none).
# SA_TRUSTED_PROXY_COUNT=
# Per-bucket rate limits (requests per minute; 0 disables a bucket).
# SA_RATELIMIT_AUTH=
# SA_RATELIMIT_AUTH_EMAIL=
# §8 key pins — all three or none; when unset a 0600 auth_keys.json is
# generated in the config dir. Never commit values.
# SA_SESSION_KEY=
# SA_REFRESH_KEY=
# SA_DATA_KEY=

# Storage locations
# SA_CONFIG_DIR=
# SA_DATA_DIR=
# SA_SPA_DIST=
# SA_BACKUP_SYNC_DIR=

# Intervals and retention
# SA_SOURCE_SCAN_INTERVAL_SEC=
# SA_AUTO_BACKUP=
# SA_BACKUP_INTERVAL_HOURS=
# SA_BACKUP_KEEP_DAILY=
# SA_BACKUP_KEEP_WEEKLY=
# SA_JOBS_DONE_TTL_DAYS=
# SA_CHECKPOINT_TTL_DAYS=
