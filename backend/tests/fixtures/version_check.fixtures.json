  "description": "Cross-language acceptance wall for the family version-check law (plan 48). Every implementation — hub-site JS (scripts/lib/semver.mjs), desktop-assistant TS (services/updates/semver.ts + policy.ts), and the Python products' vendored version_check.py — must satisfy these rows. Same law, one table, never per-language edits.",
  "semverCompare": [
    { "name": "release-above-its-prerelease", "a": "1.0.0", "b": "1.0.0-rc.1", "expected": 1 },
    { "name": "prerelease-below-release", "a": "1.0.0-rc.1", "b": "1.0.0", "expected": -1 },
    { "name": "numeric-identifiers-numeric", "a": "1.0.0-rc.10", "b": "1.0.0-rc.9", "expected": 1 },
    { "name": "numeric-below-alphanumeric", "a": "1.0.0-1", "b": "1.0.0-alpha", "expected": -1 },
    { "name": "longer-list-wins-shared-prefix", "a": "1.0.0-rc.1", "b": "1.0.0-rc.1.1", "expected": -1 },
    { "name": "segments-numeric-not-lexical", "a": "0.10.0", "b": "0.9.0", "expected": 1 },
    { "name": "equal", "a": "1.2.3", "b": "1.2.3", "expected": 0 }
  ],
  "channelOf": [
    { "name": "stable", "version": "v0.8.0", "expected": "stable" },
    { "name": "rc", "version": "v0.4.1-rc.1", "expected": "beta" },
    { "name": "beta", "version": "v0.11.0-beta.2", "expected": "beta" },
    { "name": "garbage", "version": "not-a-version", "expected": null },
    { "name": "leading-zero", "version": "01.2.3", "expected": null }
  ],
