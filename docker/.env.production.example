# Study Assistant — production environment template.
#
#   cp docker/.env.production.example docker/.env   # then edit
#
# Read by docker compose interpolation for docker-compose.standalone.yml and
# docker-compose.prod.yml. Keep this file out of git (docker/.env is
# gitignored).

# Required: Postgres password shared by the owner + app roles
# (neuronection_study_owner / neuronection_study_app). Use URL-safe characters only — it is
# embedded in SA_DATABASE_URL / SA_MIGRATIONS_DATABASE_URL.
SA_DB_PASSWORD=change-me

# Optional overrides (defaults shown):
# SA_DB_NAME=neuronection_study
# STUDY_IMAGE=ghcr.io/<owner>/<repo>:<tag>   # deploy pre-built release images
# SA_PORT=8200                               # prod flavor: host port for the app
# HTTP_PORT=80                               # standalone flavor: nginx HTTP
# HTTPS_PORT=443                             # standalone flavor: nginx TLS
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
