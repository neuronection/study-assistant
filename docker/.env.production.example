# Study Assistant — production environment template.
#
#   cp docker/.env.production.example docker/.env   # then edit
#
# Read by docker compose interpolation for docker-compose.standalone.yml and
# docker-compose.prod.yml. Keep this file out of git (docker/.env is
# gitignored).
#
# Fast path: scripts/install.sh (inside the release bundle) copies this
# example and generates every secret below itself (umask 077, values never
# printed). Filling them by hand is only needed for a manual deploy.

# --- Per-instance key family (identity-auth §8) ---------------------------
# Three INDEPENDENT secrets (all three or none — partial pins fail closed):
#   SA_SESSION_KEY — session-token signing
#   SA_REFRESH_KEY — refresh-token signing
#   SA_DATA_KEY    — encryption of secrets at rest
# Generate each separately, never derive one from another:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SA_SESSION_KEY=replace-with-generated-session-key
SA_REFRESH_KEY=replace-with-generated-refresh-key
SA_DATA_KEY=replace-with-generated-fernet-key

# Required: TWO distinct Postgres passwords (ADR-0064 — two roles, two
# credentials; the split is what makes the app role least-privilege):
#   SA_DB_OWNER_PASSWORD — `neuronection_study_owner`, DDL/migrations; used
#                          ONLY by the one-shot migrate service and the backup
#                          sidecar. Never in the app's environment.
#   SA_DB_PASSWORD       — `neuronection_study_app`, runtime DML-only.
# Use URL-safe characters only — they are embedded in the DSNs.
#
# Upgrading an existing install: the volume's roles keep their old
# passwords. Set SA_DB_OWNER_PASSWORD to the value SA_DB_PASSWORD had
# before this upgrade (or `ALTER ROLE` the owner manually), keep
# SA_DB_PASSWORD as-is — migrate re-syncs the app role's password and
# grants on every run, so rotating SA_DB_PASSWORD afterwards is just:
# change it, then `docker compose ... up -d` (migrate applies it).
SA_DB_OWNER_PASSWORD=change-me-owner
SA_DB_PASSWORD=change-me

# --- Cookie / proxy (ADR-0062 v7 §9, plan 64 §1.6) ----------------------
# Cookie `Secure` is DERIVED from the public scheme — leave
# SA_COOKIE_SECURE unset and declare where the public traffic terminates:
# Host port nginx publishes on. Default 8091 (per-product family default —
# health 8090 / study 8091 / career 8092 — so several family apps coexist
# on one host with no flags). Override per install with --http-port.
# SA_HTTP_PORT is the shell/env override the installer also accepts.
# HTTP_PORT=8091

# Interface the published port binds to. Default 0.0.0.0 (all interfaces).
# Behind your own reverse proxy on the same host, bind loopback instead:
# HTTP_BIND=127.0.0.1

#   SA_PUBLIC_URL=https://study.example.com   # public https:// via nginx-TLS/BYO proxy
#   SA_PUBLIC_URL=http://study.lan            # LAN/VPN plain HTTP (login keeps working)
#   SA_TLS=1                                  # TLS terminates on another host's proxy
# SA_TRUSTED_PROXY_COUNT: how many rightmost X-Forwarded-For hops to
# believe — 1 behind the shipped nginx, raise under a longer trusted chain.
# SA_PUBLIC_URL=
# SA_TLS=
# SA_COOKIE_SECURE=
# SA_TRUSTED_PROXY_COUNT=1

# --- Off-host backup upload (ADR-0063) -----------------------------------
# Set one or more targets for scripts/backup.sh; every run appends a row to
# backups/backup_runs.jsonl. With no target, runs stay on this host (a DR
# gap on T1 — the ledger marks them "local-only").
# SA_BACKUP_RCLONE_REMOTE=myremote:study-backups
# SA_BACKUP_S3_URI=s3://my-bucket/study
# SA_BACKUP_AZURE_URL=https://acct.blob.core.windows.net/cont/study?<sas>
# Optional age encryption (the family backup rule: encrypt whenever the
# destination is shared; keep the age PRIVATE key offline, never on this
# host). SA_BACKUP_AGE_RECIPIENT is study's name, BACKUP_AGE_RECIPIENT the
# family alias — either works:
# SA_BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_RECIPIENT=age1...

# Optional overrides (defaults shown):
# SA_DB_NAME=neuronection_study
# STUDY_IMAGE=ghcr.io/<owner>/<repo>:<tag>   # deploy pre-built release images
# SA_PORT=8200                               # prod flavor: host port for the app
# HTTP_PORT=80                               # standalone flavor: nginx HTTP
# HTTPS_PORT=443                             # standalone flavor: nginx TLS
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# --- Family object storage (ADR-0057) ---------------------------------
# Leave everything commented for a local-volume self-host deployment.
# A cloud profile must use object storage only; combine
# docker-compose.cloud.yml and set one provider block below.
#
# AWS S3 / any S3-compatible endpoint (MinIO, R2, B2, Wasabi, Ceph).
# Deploy with the overlay:
#   docker compose -f docker/docker-compose.prod.yml \
#                  -f docker/docker-compose.cloud.yml up -d
# Leave SA_OBJECT_STORAGE_MAX_MB unset (study's 200 MB host cap); do not
# pin 100 here.
#
# AWS S3 — instance/task role (recommended; no static keys in env):
# SA_CLOUD_PROFILE=aws
# SA_OBJECT_STORAGE_BACKEND=s3
# SA_S3_BUCKET=neuronection-study-prod
# SA_S3_REGION=eu-central-1
# SA_S3_PREFIX=prod/
# SA_S3_SSE=aws:kms
# SA_S3_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/...
#
# AWS S3 — static keys + KMS (prefer the role; rotate and never commit):
# SA_CLOUD_PROFILE=aws
# SA_OBJECT_STORAGE_BACKEND=s3
# SA_S3_BUCKET=neuronection-study-prod
# SA_S3_REGION=eu-central-1
# SA_S3_ACCESS_KEY_ID=...
# SA_S3_SECRET_ACCESS_KEY=...
# SA_S3_SSE=aws:kms
# SA_S3_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/...
# SA_S3_PREFIX=prod/
#
# S3-compatible endpoint under a cloud profile (SSE AES256/aws:kms is
# required under a cloud profile):
# SA_CLOUD_PROFILE=cloud
# SA_OBJECT_STORAGE_BACKEND=s3
# SA_S3_BUCKET=study
# SA_S3_ENDPOINT_URL=https://minio.example.com
# SA_S3_PATH_STYLE=true
# SA_S3_ACCESS_KEY_ID=...
# SA_S3_SECRET_ACCESS_KEY=...
# SA_S3_SSE=AES256
# SA_S3_PREFIX=prod/
#
# S3-compatible gateway that rejects the AWS SSE header — self-host object
# storage (no cloud profile; custom endpoints default to SSE=none):
# SA_OBJECT_STORAGE_REQUIRED=true
# SA_OBJECT_STORAGE_BACKEND=s3
# SA_S3_BUCKET=study
# SA_S3_ENDPOINT_URL=https://minio.example.com
# SA_S3_PATH_STYLE=true
# SA_S3_ACCESS_KEY_ID=...
# SA_S3_SECRET_ACCESS_KEY=...
# SA_S3_SSE=none
# SA_S3_PREFIX=prod/
#
# Azure Blob — managed identity (recommended):
# SA_CLOUD_PROFILE=azure
# SA_OBJECT_STORAGE_BACKEND=azure_blob
# SA_AZURE_STORAGE_CONTAINER=study-data
# SA_AZURE_STORAGE_ACCOUNT_URL=https://study.blob.core.windows.net
# SA_AZURE_STORAGE_ACCOUNT_NAME=study
# SA_AZURE_STORAGE_CREDENTIAL=managed_identity
# SA_AZURE_STORAGE_PREFIX=prod/
# (Do not put a raw expiring token in env; the sentinel selects
# DefaultAzureCredential.)
#
# Azure Blob — connection string (secret):
# SA_CLOUD_PROFILE=azure
# SA_OBJECT_STORAGE_BACKEND=azure_blob
# SA_AZURE_STORAGE_CONTAINER=study-data
# SA_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=study;AccountKey=...;EndpointSuffix=core.windows.net
# SA_AZURE_STORAGE_PREFIX=prod/
#
# Azure Blob — account-key alternative (prefer managed identity; a SAS
# works for access but cannot presign, while an account key can):
# SA_CLOUD_PROFILE=azure
# SA_OBJECT_STORAGE_BACKEND=azure_blob
# SA_AZURE_STORAGE_CONTAINER=study-data
# SA_AZURE_STORAGE_ACCOUNT_URL=https://study.blob.core.windows.net
# SA_AZURE_STORAGE_ACCOUNT_NAME=study
# SA_AZURE_STORAGE_CREDENTIAL=<account-key>
# SA_AZURE_STORAGE_PREFIX=prod/
#
# Azure with an S3-compatible gateway (MinIO on Azure; the azure cloud
# profile requires SSE AES256/aws:kms):
# SA_CLOUD_PROFILE=azure
# SA_OBJECT_STORAGE_BACKEND=s3
# SA_S3_BUCKET=study
# SA_S3_ENDPOINT_URL=https://minio.example.internal
# SA_S3_ACCESS_KEY_ID=...
# SA_S3_SECRET_ACCESS_KEY=...
# SA_S3_PATH_STYLE=true
# SA_S3_SSE=AES256
# SA_S3_PREFIX=prod/
